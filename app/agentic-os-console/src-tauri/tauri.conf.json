{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "talabat Agentic OS",
  "version": "1.0.0",
  "identifier": "com.talabat.agenticos.console",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "windows": [
      {
        "title": "talabat Agentic OS Console",
        "width": 1280,
        "height": 840,
        "minWidth": 900,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Business",
    "shortDescription": "Command console for the talabat Agentic OS",
    "longDescription": "Command console for the talabat Agentic OS — AI-enabled capital allocation and performance management for the 2026 USD 175 million investment programme. AASTMT MBA Capstone, Group G02.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
